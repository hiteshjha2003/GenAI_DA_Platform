# ============================================
# GenAI Data Analytics Platform
# Environment Configuration Template
# ============================================

# Copy this file to .env and fill in your values

# ============================================
# LLM Providers
# Optional - app works in demo mode without these
# ============================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Groq API Key
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-api-key-here

# ============================================
# Database Configuration
# Optional - for SQL Server connection
# ============================================

# SQL Server hostname or IP
DB_SERVERNAME=localhost

# Database name
DB_DATABASE=mydb

# Database username (SQL Server authentication)
DB_USERNAME=sa

# Database password
DB_PASSWORD=your-password

# ============================================
# Ollama Configuration
# For local LLM model support
# ============================================

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Model name
OLLAMA_MODEL=llama2

# ============================================
# Default Settings
# ============================================

# Default LLM provider: openai, groq, or ollama
DEFAULT_LLM_PROVIDER=openai

# Application port (for local development)
PORT=8000

# Environment: development or production
ENVIRONMENT=development

# ============================================
# Notes
# ============================================

# 1. Never commit .env file to Git
# 2. Keep API keys secret
# 3. For Vercel: Add these as Environment Variables in dashboard
# 4. Demo mode works without any of these settings
